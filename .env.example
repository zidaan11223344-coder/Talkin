# Required TalkinChat credentials
BOT_ID=
BOT_PWD=
BOT_MASTER=
GROUP_TO_JOIN=

# Chat/API connection
API_BASE_URL=https://chatp.net/api?
HOST_HEADER=chatp.net
WS_HOSTS=chatp.net
SOCKET_PORT=5335
WS_PATHS=/server
REFERRER_URL=
LANGUAGE=ar

# Device identity is detected automatically when available; no device variables are required.

# Runtime diagnostics
DEBUG=0
RAW_DIAGNOSTIC=0
ACK_ROOM_EVENTS=1
AUTO_HELP=1
AUTO_REJOIN=1
BANNED_WORDS=
AUTO_BAN_WORDS=0

# Transferred features
MUSIC_COOLDOWN_SECONDS=20
PUBLIC_BASE_URL=
RAILWAY_PUBLIC_DOMAIN=

# YouTube / yt-dlp (keep these values private)
# Netscape cookies text; supports literal \\n and \\t or base64:<encoded Netscape file>
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_1=
YOUTUBE_COOKIES_2=
YOUTUBE_COOKIES_3=
YOUTUBE_COOKIES_4=
YOUTUBE_COOKIES_5=
YOUTUBE_COOKIES_6=
YOUTUBE_COOKIES_7=
YOUTUBE_COOKIES_8=
YOUTUBE_COOKIES_9=
YOUTUBE_COOKIES_10=
YOUTUBE_COOKIES_PATH=
YOUTUBE_PO_TOKEN=
YOUTUBE_PLAYER_CLIENTS=default,web_embedded
TIKTOK_COOKIES=
